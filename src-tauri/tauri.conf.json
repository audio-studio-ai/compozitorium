{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Compozitorium AI Studio",
  "version": "0.1.0",
  "identifier": "io.github.compozitorium.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Compozitorium AI Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "category": "Music",
    "copyright": "Copyright (c) 2026 Evgenii Zabairachnyi",
    "publisher": "https://github.com/z-ev",
    "homepage": "https://github.com/audio-studio-ai/compozitorium",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Smart audio editor with AI",
    "longDescription": "Compozitorium AI Studio is a desktop app for recording, editing and generating audio with AI. Dictate, synthesize speech and music, then assemble the result on a timeline and export to common formats.",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "section": "sound",
        "desktopTemplate": "./linux/app.desktop",
        "postInstallScript": "./linux/postinst",
        "postRemoveScript": "./linux/postrm",
        "files": {
          "/usr/share/metainfo/io.github.compozitorium.studio.metainfo.xml": "./io.github.compozitorium.studio.metainfo.xml",
          "/usr/share/applications/io.github.compozitorium.studio.desktop": "./linux/io.github.compozitorium.studio.desktop",
          "/usr/share/swcatalog/xml/io.github.compozitorium.studio.xml": "./linux/swcatalog.xml",
          "/usr/share/swcatalog/icons/compozitorium/64x64/io.github.compozitorium.studio.png": "./icons/64x64.png",
          "/usr/share/swcatalog/icons/compozitorium/128x128/io.github.compozitorium.studio.png": "./icons/128x128.png",
          "/usr/share/doc/compozitorium-ai-studio/copyright": "./linux/copyright",
          "/usr/share/pixmaps/io.github.compozitorium.studio.png": "./icons/128x128.png",
          "/usr/share/pixmaps/compozitorium-ai-studio.png": "./icons/128x128.png",
          "/usr/share/icons/hicolor/64x64/apps/io.github.compozitorium.studio.png": "./icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/io.github.compozitorium.studio.png": "./icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.compozitorium.studio.png": "./icons/256x256.png"
        }
      }
    }
  }
}
