{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Compozitorium AI Studio",
  "version": "0.1.0",
  "identifier": "io.github.compozitorium.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Compozitorium AI Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "category": "Music",
    "copyright": "Copyright (c) 2026 Evgenii Zabairachnyi",
    "publisher": "https://github.com/z-ev",
    "homepage": "https://github.com/audio-studio-ai/compozitorium",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Compozitorium AI Studio - smart audio editor with AI",
    "longDescription": "Compozitorium AI Studio is a desktop application for audio processing powered by artificial intelligence. It supports recording, editing, noise reduction, and export to popular formats.",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "section": "sound",
        "files": {
          "/usr/share/metainfo/io.github.compozitorium.app.metainfo.xml": "./io.github.compozitorium.app.metainfo.xml"
        }
      }
    }
  }
}
